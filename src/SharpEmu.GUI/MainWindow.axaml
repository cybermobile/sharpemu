<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SharpEmu.GUI.MainWindow"
        Title="SharpEmu"
        Width="1380" Height="880"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="64"
        Icon="avares://SharpEmu.GUI/Assets/SharpEmu.ico"
        KeyDown="OnKeyDown">

  <Window.Resources>
    <DataTemplate x:Key="InputBindingRowTemplate">
      <Grid Width="300" ColumnDefinitions="*,150" Margin="0,4,8,4">
        <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"
                   Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}"
                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                  DisplayMemberBinding="{Binding Label}" CornerRadius="8"
                  AutomationProperties.Name="{Binding Label}" />
      </Grid>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="InputBindingPanelTemplate">
      <WrapPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
  </Window.Resources>

  <Grid x:Name="MainShell" RowDefinitions="64,*,36">

    <!-- Selected-game backdrop: key art behind the main content, dimmed by
         a scrim so tiles and text stay readable. Fades on selection. -->
    <Panel Grid.Row="1" ClipToBounds="True">
      <Image x:Name="BackdropImage" Stretch="UniformToFill" Opacity="0"
             HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
          </Transitions>
        </Image.Transitions>
      </Image>
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#730D1017" />
            <GradientStop Offset="0.55" Color="#BF0D1017" />
            <GradientStop Offset="1" Color="#EB0D1017" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Panel>

    <!-- Desktop title/menu chrome. The left inset shares native title-bar
         space with macOS traffic lights. -->
    <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource ChromeBrush}"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel x:Name="TitleBarContent" Grid.Column="0" Orientation="Horizontal" Spacing="10"
                    Margin="16,0,22,0" VerticalAlignment="Center">
          <Image Source="avares://SharpEmu.GUI/Assets/SharpEmu.ico" Width="28" Height="28"
                 RenderOptions.BitmapInterpolationMode="HighQuality"
                 AutomationProperties.AccessibilityView="Raw" />
          <TextBlock Text="SharpEmu" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock x:Name="VersionText" Text="v0.0.1" FontSize="11"
                     Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <Menu Grid.Column="1" Classes="mainMenu" VerticalAlignment="Center"
              AutomationProperties.LandmarkType="Navigation">
          <MenuItem x:Name="FileMenuItem" Header="File">
            <MenuItem x:Name="MenuOpenFile" Header="Open file…" />
            <MenuItem x:Name="MenuAddFolder" Header="Add folder…" />
            <MenuItem x:Name="MenuRescan" Header="Rescan library" />
          </MenuItem>
          <MenuItem x:Name="ViewMenuItem" Header="View">
            <MenuItem x:Name="MenuLibrary" Header="Library" />
            <MenuItem x:Name="MenuSettings" Header="Settings" />
            <Separator />
            <MenuItem x:Name="MenuConsole" Header="Console" />
            <MenuItem x:Name="MenuFullscreen" Header="Toggle fullscreen" InputGesture="F11" />
          </MenuItem>
          <MenuItem x:Name="HelpMenuItem" Header="Help">
            <MenuItem x:Name="MenuGithub" Header="Project repository" />
            <MenuItem x:Name="MenuDiscord" Header="Community Discord" />
          </MenuItem>
        </Menu>

        <Border Grid.Column="2" Classes="pill" Margin="16,0" VerticalAlignment="Center">
          <TextBlock x:Name="BuildCardTitle" Text="EXPERIMENTAL BUILD" Classes="navLabel" />
        </Border>
      </Grid>
    </Border>

    <!-- Main content -->
    <Grid Grid.Row="1" Margin="28,0,28,20" RowDefinitions="Auto,*,Auto,Auto"
          MaxWidth="1440" HorizontalAlignment="Stretch">

      <!-- Compact emulator command bar: library search leads while workspace
           switching remains visible. File operations stay in the File menu. -->
      <Grid Grid.Row="0" MinHeight="76" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
          <TextBlock x:Name="PageTitleText" Text="Library" FontSize="26" FontWeight="Bold"
                     AutomationProperties.HeadingLevel="1" />
          <TextBlock x:Name="PageSubtitleText" Text="Browse, inspect, and launch installed games."
                     FontSize="12" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                   VerticalAlignment="Center" AutomationProperties.LandmarkType="Navigation">
          <TextBox x:Name="SearchBox" Watermark="Search library…" Width="240" Margin="3,0,10,0"
                   VerticalAlignment="Center" VerticalContentAlignment="Center"
                   AutomationProperties.Name="Search library"
                   AutomationProperties.HelpText="Filter games by title or title ID."
                   AutomationProperties.AutomationId="LibrarySearchBox" />
          <Button x:Name="LibraryTabButton" Classes="toolbarNav active" Content="Library" Margin="3,0"
                  ToolTip.Tip="Controller shortcut: L1 / LB"
                  AutomationProperties.AutomationId="LibraryPageButton" />
          <Button x:Name="OptionsTabButton" Classes="toolbarNav" Content="Settings" Margin="3,0"
                  ToolTip.Tip="Controller shortcut: R1 / RB"
                  AutomationProperties.AutomationId="OptionsPageButton" />
        </WrapPanel>
      </Grid>

      <Panel Grid.Row="1">

        <!-- Library page: artwork reflows with the available desktop width;
             the content begins close to navigation to preserve usable space. -->
        <Panel x:Name="LibraryPage" Margin="0,12,0,0"
               AutomationProperties.LandmarkType="Main">
          <ListBox x:Name="GameList" Classes="tileGrid" Background="Transparent"
                   SelectionMode="Single" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Game library"
                   AutomationProperties.HelpText="Choose a game to view details or launch it."
                   AutomationProperties.AutomationId="GameLibraryList">
            <ListBox.ContextMenu>
              <ContextMenu x:Name="GameContextMenu" Placement="Pointer">
                <MenuItem x:Name="CtxLaunch" Header="Launch" FontWeight="SemiBold" />
                <MenuItem x:Name="CtxOpenFolder" Header="Open game folder" />
                <Separator />
                <MenuItem x:Name="CtxCopyPath" Header="Copy path" />
                <MenuItem x:Name="CtxCopyTitleId" Header="Copy title ID" />
                <Separator />
                <MenuItem x:Name="CtxRemove" Header="Remove from library"
                          Foreground="{StaticResource DangerHoverBrush}" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="168" Height="222" Spacing="10">
                  <Border Classes="coverShadow" Width="168" Height="168">
                    <Border Classes="coverClip">
                      <Panel>
                        <Border Background="{Binding PlaceholderBrush}" IsVisible="{Binding !HasCover}">
                          <TextBlock Text="{Binding Initials}" FontSize="42" FontWeight="Bold"
                                     Foreground="#E8ECF4" Opacity="0.85"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding HasCover}"
                               AutomationProperties.AccessibilityView="Raw" />
                      </Panel>
                    </Border>
                  </Border>
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                             TextAlignment="Left" HorizontalAlignment="Stretch" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Empty state -->
          <StackPanel x:Name="EmptyState" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsVisible="False">
            <Border Width="88" Height="88" CornerRadius="22" Background="{StaticResource ElevatedBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" Margin="0,0,0,6">
              <Image Source="avares://SharpEmu.GUI/Assets/SharpEmu.ico" Width="52" Height="52"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <TextBlock x:Name="EmptyStateTitle" Text="Your library is empty" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" AutomationProperties.HeadingLevel="2" />
            <TextBlock x:Name="EmptyStateHint" Text="Add a folder containing your games to get started."
                       FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
            <Button x:Name="EmptyAddFolderButton" Classes="accent" Content="＋ Add game folder"
                    HorizontalAlignment="Center" Margin="0,8,0,0"
                    AutomationProperties.AutomationId="EmptyLibraryAddFolderButton" />
          </StackPanel>

          <!-- Loading state: covers the grid while a scan (initial load,
               rescan, or a just-added folder) is in flight, so the screen
               never looks blank mid-scan. -->
          <StackPanel x:Name="LoadingState" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsVisible="False" AutomationProperties.LiveSetting="Polite">
            <ProgressBar IsIndeterminate="True" Width="180" Height="3" />
            <TextBlock x:Name="LoadingStateText" Text="Loading library…" FontSize="13"
                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
          </StackPanel>
        </Panel>

        <!-- Settings workspace: PCSX2-inspired category rail with an explicit
             global scope. Debug/environment controls remain a separate category. -->
        <Grid x:Name="OptionsPage" IsVisible="False" RowDefinitions="Auto,*"
              MaxWidth="1120" HorizontalAlignment="Stretch"
              AutomationProperties.LandmarkType="Main">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,14">
            <StackPanel Spacing="3">
              <TextBlock x:Name="SettingsScopeTitle" Text="Global settings" FontSize="18" FontWeight="SemiBold" />
              <TextBlock x:Name="SettingsScopeDescription"
                         Text="These defaults apply to every game unless a future per-game profile overrides them."
                         FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center" Margin="16,0,0,0">
              <TextBlock x:Name="SettingsScopeBadge" Text="ALL GAMES" Classes="navLabel" />
            </Border>
          </Grid>
          <TabControl Grid.Row="1" TabStripPlacement="Left" HorizontalAlignment="Stretch">
            <TabItem x:Name="GeneralTabItem" Header="General" FontSize="15"
                     HorizontalContentAlignment="Stretch">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Visible" HorizontalAlignment="Stretch">
                <StackPanel Margin="0,14,0,16" Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">

                  <Border Classes="card">
                    <StackPanel Spacing="14">
                      <TextBlock x:Name="EmulationSectionTitle" Classes="sectionTitle" Text="EMULATION"
                                 AutomationProperties.HeadingLevel="2" />

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock x:Name="CpuEngineLabel" Text="CPU engine" FontSize="13" />
                          <TextBlock x:Name="CpuEngineDesc" Text="Execution engine used to run game code."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="CpuEngineBox" Width="160" SelectedIndex="0"
                                  VerticalAlignment="Center" CornerRadius="8">
                          <ComboBoxItem x:Name="CpuEngineNativeItem" Content="Native" />
                        </ComboBox>
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock x:Name="StrictLabel" Text="Strict dynlib resolution" FontSize="13" />
                          <TextBlock x:Name="StrictDesc" Text="Fail the launch when an imported symbol cannot be resolved."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="StrictToggle" OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Classes="card">
                    <StackPanel Spacing="14">
                      <TextBlock x:Name="LoggingSectionTitle" Classes="sectionTitle" Text="LOGGING"
                                 AutomationProperties.HeadingLevel="2" />

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock x:Name="LogLevelLabel" Text="Log level" FontSize="13" />
                          <TextBlock x:Name="LogLevelDesc" Text="Verbosity of the emulator console output."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="LogLevelBox" Width="160" SelectedIndex="2"
                                  VerticalAlignment="Center" CornerRadius="8">
                          <ComboBoxItem x:Name="LogLevelTraceItem" Content="Trace" />
                          <ComboBoxItem x:Name="LogLevelDebugItem" Content="Debug" />
                          <ComboBoxItem x:Name="LogLevelInfoItem" Content="Info" />
                          <ComboBoxItem x:Name="LogLevelWarningItem" Content="Warning" />
                          <ComboBoxItem x:Name="LogLevelErrorItem" Content="Error" />
                          <ComboBoxItem x:Name="LogLevelCriticalItem" Content="Critical" />
                        </ComboBox>
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock x:Name="TraceImportsLabel" Text="Import trace limit" FontSize="13" />
                          <TextBlock x:Name="TraceImportsDesc" Text="Trace the first N imports per module (0 = off)."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <NumericUpDown Grid.Column="1" x:Name="TraceImportsBox" Width="160" Minimum="0"
                                       Maximum="4096" Increment="16" Value="0" FormatString="0"
                                       VerticalAlignment="Center" CornerRadius="8" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock x:Name="LogToFileLabel" Text="Log to file" FontSize="13" />
                          <TextBlock x:Name="LogToFileDesc" Text="Mirror emulator output to a log file."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="LogToFileToggle" OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock x:Name="LogFilePathLabel" Text="Log file path" FontSize="13" />
                          <TextBlock x:Name="LogFilePathText" Text="No custom path"
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="SelectLogFilePathButton" Classes="ghost" Content="Select…"
                                VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock x:Name="OverrideLogFileLabel" Text="Override log file" FontSize="13" />
                          <TextBlock x:Name="OverrideLogFileDesc"
                                     Text="Use the exact file path instead of appending title ID and timestamp."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="OverrideLogFileToggle" OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Classes="card">
                    <StackPanel Spacing="14">
                      <TextBlock x:Name="LauncherSectionTitle" Classes="sectionTitle" Text="LAUNCHER"
                                 AutomationProperties.HeadingLevel="2" />

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock x:Name="LanguageLabel" Text="Emulator language" FontSize="13" />
                          <TextBlock x:Name="LanguageDesc"
                                     Text="Language used throughout the launcher. Applies immediately."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="LanguageBox" Width="160"
                                  VerticalAlignment="Center" CornerRadius="8"
                                  DisplayMemberBinding="{Binding NativeName}" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock x:Name="TitleMusicLabel" Text="Title music" FontSize="13" />
                          <TextBlock x:Name="TitleMusicDesc" Text="Loop the selected game's preview music in the library."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="TitleMusicToggle" OnContent="On" OffContent="Off"
                                      IsChecked="True" VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock x:Name="DiscordLabel" Text="Discord presence" FontSize="13" />
                          <TextBlock x:Name="DiscordDesc" Text="Show the running game on your Discord profile."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="DiscordToggle" OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="14">
                      <TextBlock x:Name="AboutSectionTitle"
                                Classes="sectionTitle"
                                Text="ABOUT"
                                AutomationProperties.HeadingLevel="2" />
                      
                      <!--Github-->
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0"
                                      Orientation="Horizontal"
                                      Spacing="8"
                                      VerticalAlignment="Center">
                          <Image Source="avares://SharpEmu.GUI/Assets/github.png"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw" />
                          <StackPanel VerticalAlignment="Center"
                                          Spacing="2">
                            <TextBlock x:Name="GithubLabel"
                                            Text="GitHub"
                                            FontSize="13" />
                            <TextBlock x:Name="GithubDesc"
                                            Text="Source code, issues and project development."
                                            FontSize="11"
                                            Foreground="{StaticResource MutedBrush}"
                                            TextWrapping="Wrap" />
                          </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="GithubButton"
                                Classes="ghost"
                                Content="Open"
                                VerticalAlignment="Center"
                                MinWidth="144"
                                AutomationProperties.AutomationId="OpenGithubButton" />
                      </Grid>

                      <!--Discord-->
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                          <Image Source="avares://SharpEmu.GUI/Assets/discord.png"
                                  Width="20"
                                  Height="20"
                                  VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw" />
                          <StackPanel VerticalAlignment="Center"
                                      Spacing="2">
                            <TextBlock x:Name="DiscordServerLabel"
                                      Text="Discord"
                                      FontSize="13" />
                            <TextBlock x:Name="DiscordServerDesc"
                                      Text="Join the community, get support and follow development."
                                      FontSize="11"
                                      Foreground="{StaticResource MutedBrush}"
                                      TextWrapping="Wrap" />
                          </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="DiscordButton"
                                Classes="ghost"
                                Content="Join"
                                VerticalAlignment="Center"
                                MinWidth="144"
                                AutomationProperties.AutomationId="OpenDiscordButton" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ControlsTabItem" Header="Controls" FontSize="15"
                     HorizontalContentAlignment="Stretch">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Visible" HorizontalAlignment="Stretch">
                <StackPanel Margin="0,14,0,16" Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3" Margin="0,0,16,0">
                      <TextBlock x:Name="ControlsPageTitle" Text="Input mappings" FontSize="18"
                                 FontWeight="SemiBold" AutomationProperties.HeadingLevel="2" />
                      <TextBlock x:Name="ControlsPageDescription"
                                 Text="Global mappings apply when the next game starts. Launcher navigation keeps its standard layout."
                                 FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ResetInputMappingsButton" Grid.Column="1" Classes="ghost compact"
                            Content="Reset defaults" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ResetInputMappingsButton" />
                  </Grid>

                  <Border Classes="card">
                    <StackPanel Spacing="10">
                      <TextBlock x:Name="InputDeviceModeLabel" Classes="sectionTitle"
                                 Text="CHOOSE INPUT DEVICE" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton x:Name="ControllerInputModeButton" Classes="toolbarNav active"
                                      Content="Controller" IsChecked="True"
                                      AutomationProperties.AutomationId="ControllerInputModeButton" />
                        <ToggleButton x:Name="KeyboardInputModeButton" Classes="toolbarNav"
                                      Content="Keyboard"
                                      AutomationProperties.AutomationId="KeyboardInputModeButton" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <StackPanel x:Name="ControllerInputPanel" Spacing="16">
                    <Border Classes="card">
                      <StackPanel Spacing="10">
                        <TextBlock x:Name="ControllerDiagramTitle" Classes="sectionTitle"
                                   Text="DUALSENSE LAYOUT" />
                        <TextBlock x:Name="ControllerDiagramDescription"
                                   Text="Use the diagram to locate each control, then choose its mapping below."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Border Background="Transparent" Padding="4" Width="400"
                                HorizontalAlignment="Center" ClipToBounds="True">
                          <Image x:Name="ControllerImage"
                                 Source="avares://SharpEmu.GUI/Assets/DualSense-Controller-transparent.png"
                                 Stretch="Uniform" MaxHeight="300" HorizontalAlignment="Center"
                                 RenderOptions.BitmapInterpolationMode="HighQuality"
                                 AutomationProperties.Name="White DualSense controller showing its buttons, touchpad, and analog sticks." />
                        </Border>
                      </StackPanel>
                    </Border>

                    <Border Classes="card">
                      <StackPanel Spacing="10">
                        <TextBlock x:Name="ControllerBindingsTitle" Classes="sectionTitle"
                                   Text="CONTROLLER BUTTONS" />
                        <TextBlock x:Name="ControllerBindingsDescription"
                                   Text="Choose which physical control drives each PlayStation button."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="ControllerBindingList"
                                      ItemTemplate="{StaticResource InputBindingRowTemplate}"
                                      ItemsPanel="{StaticResource InputBindingPanelTemplate}" />
                      </StackPanel>
                    </Border>

                    <Border Classes="card">
                      <StackPanel Spacing="14">
                        <TextBlock x:Name="StickSettingsTitle" Classes="sectionTitle" Text="STICKS" />
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="2" Margin="0,0,16,0">
                            <TextBlock x:Name="StickDeadzoneLabel" Text="Stick deadzone" FontSize="13" />
                            <TextBlock x:Name="StickDeadzoneDescription"
                                       Text="Ignore small movement around the center position (0–64)."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                          </StackPanel>
                          <NumericUpDown x:Name="StickDeadzoneBox" Grid.Column="1" Width="160"
                                         Minimum="0" Maximum="64" Increment="1" FormatString="0" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock x:Name="SwapSticksLabel" Text="Swap left and right sticks" FontSize="13"
                                     VerticalAlignment="Center" />
                          <ToggleSwitch x:Name="SwapSticksToggle" Grid.Column="1" OnContent="On" OffContent="Off" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock x:Name="InvertLeftXLabel" Text="Invert left stick X" FontSize="13"
                                     VerticalAlignment="Center" />
                          <ToggleSwitch x:Name="InvertLeftXToggle" Grid.Column="1" OnContent="On" OffContent="Off" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock x:Name="InvertLeftYLabel" Text="Invert left stick Y" FontSize="13"
                                     VerticalAlignment="Center" />
                          <ToggleSwitch x:Name="InvertLeftYToggle" Grid.Column="1" OnContent="On" OffContent="Off" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock x:Name="InvertRightXLabel" Text="Invert right stick X" FontSize="13"
                                     VerticalAlignment="Center" />
                          <ToggleSwitch x:Name="InvertRightXToggle" Grid.Column="1" OnContent="On" OffContent="Off" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock x:Name="InvertRightYLabel" Text="Invert right stick Y" FontSize="13"
                                     VerticalAlignment="Center" />
                          <ToggleSwitch x:Name="InvertRightYToggle" Grid.Column="1" OnContent="On" OffContent="Off" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel x:Name="KeyboardInputPanel" Spacing="16" IsVisible="False">
                    <Border Classes="card">
                      <StackPanel Spacing="10">
                        <TextBlock x:Name="KeyboardBindingsTitle" Classes="sectionTitle"
                                   Text="KEYBOARD BUTTONS" />
                        <TextBlock x:Name="KeyboardBindingsDescription"
                                   Text="Assign a primary keyboard key to each PlayStation button. Choose Unbound to disable it."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="KeyboardBindingList"
                                      ItemTemplate="{StaticResource InputBindingRowTemplate}"
                                      ItemsPanel="{StaticResource InputBindingPanelTemplate}" />
                      </StackPanel>
                    </Border>

                    <Border Classes="card">
                      <StackPanel Spacing="10">
                        <TextBlock x:Name="KeyboardSticksTitle" Classes="sectionTitle"
                                   Text="KEYBOARD STICKS" />
                        <TextBlock x:Name="KeyboardSticksDescription"
                                   Text="Assign the negative and positive directions for both analog sticks."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="KeyboardAxisBindingList"
                                      ItemTemplate="{StaticResource InputBindingRowTemplate}"
                                      ItemsPanel="{StaticResource InputBindingPanelTemplate}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem x:Name="EnvTabItem" Header="Environment" FontSize="15"
                     HorizontalContentAlignment="Stretch">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Visible" HorizontalAlignment="Stretch">
                <StackPanel Margin="0,14,0,16" Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">

                  <Border Classes="card">
                    <StackPanel Spacing="14">
                      <TextBlock x:Name="EnvSectionTitle" Classes="sectionTitle" Text="ENVIRONMENT VARIABLES"
                                 AutomationProperties.HeadingLevel="2" />
                      <TextBlock x:Name="EnvDesc"
                                 Text="Switches passed to the emulator as environment variables at launch."
                                 FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock Text="SHARPEMU_BTHID_UNAVAILABLE" FontSize="13" FontFamily="Consolas,monospace" />
                          <TextBlock x:Name="EnvBthidDesc"
                                     Text="Report Bluetooth HID as unavailable for titles whose wheel/FFB middleware polls forever.&#10;Leave off normally. Some titles freeze when init fails."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="EnvBthidToggle" OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock Text="SHARPEMU_DISABLE_IMPORT_LOOP_GUARD" FontSize="13" FontFamily="Consolas,monospace" />
                          <TextBlock x:Name="EnvLoopGuardDesc"
                                     Text="Do not force quit titles that repeat the same call for too long.&#10;Try this when a game exits on its own while loading."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="EnvLoopGuardToggle" OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock Text="SHARPEMU_VK_VALIDATION" FontSize="13" FontFamily="Consolas,monospace" />
                          <TextBlock x:Name="EnvVkValidationDesc"
                                     Text="Enable Vulkan validation layers for GPU debugging.&#10;Slow. Requires the Vulkan SDK to be installed."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="EnvVkValidationToggle" OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock Text="SHARPEMU_DUMP_SPIRV" FontSize="13" FontFamily="Consolas,monospace" />
                          <TextBlock x:Name="EnvDumpSpirvDesc"
                                     Text="Dump AGC shaders and their SPIR-V translations to the shader-dumps folder.&#10;Use when reporting shader or rendering bugs."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="EnvDumpSpirvToggle" OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock Text="SHARPEMU_LOG_DIRECT_MEMORY" FontSize="13" FontFamily="Consolas,monospace" />
                          <TextBlock x:Name="EnvLogDirectMemoryDesc"
                                     Text="Log direct memory allocations and failures to the console.&#10;Use when a game aborts or exits during boot."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="EnvLogDirectMemoryToggle" OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                          <TextBlock Text="SHARPEMU_LOG_NP" FontSize="13" FontFamily="Consolas,monospace" />
                          <TextBlock x:Name="EnvLogNpDesc"
                                     Text="Log NP (PlayStation Network) library calls to the console."
                                     FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="EnvLogNpToggle" OnContent="On" OffContent="Off"
                                      VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                  </Border>

                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </Panel>

      <!-- Console (collapsible) -->
      <Border Grid.Row="2" x:Name="ConsolePanel" Classes="card" Padding="0" Height="260"
              Margin="0,12,0,0" IsVisible="False">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="16,12,16,8">
            <TextBlock x:Name="ConsoleSectionTitle" Classes="sectionTitle" Text="CONSOLE" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" FontSize="12" Margin="0,0,12,0" x:Name="ConsoleSearchBox"
                    Watermark="Search..." Width="280"
                    AutomationProperties.Name="Search console output"
                    AutomationProperties.AutomationId="ConsoleSearchBox" />
            <CheckBox Grid.Column="2" x:Name="AutoScrollCheck" Content="Auto-scroll" IsChecked="True"
                    FontSize="12" Margin="0,0,12,0" />
            <Button Grid.Column="3" x:Name="DetachConsoleButton" Classes="ghost" Content="Split" FontSize="12"
                    Padding="10,4" Margin="0,0,8,0" />
            <Button Grid.Column="4" x:Name="CopyLogButton" Classes="ghost" Content="Copy" FontSize="12"
                    Padding="10,4" Margin="0,0,8,0" />
            <Button Grid.Column="5" x:Name="ClearLogButton" Classes="ghost" Content="Clear" FontSize="12"
                    Padding="10,4" />
          </Grid>
          <ListBox Grid.Row="1" x:Name="ConsoleList" Classes="console" BorderThickness="0,1,0,0"
                   BorderBrush="{StaticResource CardBorderBrush}" CornerRadius="0,0,12,12"
                   AutomationProperties.Name="Emulator console output"
                   AutomationProperties.AutomationId="ConsoleOutputList">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="NoWrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Selected-game inspector and primary actions. -->
      <Border x:Name="SelectedGamePanel" Grid.Row="3" Classes="actionPanel" Margin="0,16,0,0" Padding="18">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- Selected game cover thumbnail -->
            <Border Grid.Column="0" Classes="coverClip" Width="72" Height="72" CornerRadius="10"
                    VerticalAlignment="Center">
              <Panel x:Name="SelectedCoverPanel">
                <Image Source="avares://SharpEmu.GUI/Assets/SharpEmu.ico" Width="34" Height="34"
                       Opacity="0.28" HorizontalAlignment="Center" VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw" />
                <Border Background="{Binding PlaceholderBrush, FallbackValue={x:Null}}"
                        IsVisible="{Binding !HasCover, FallbackValue=False}">
                  <TextBlock Text="{Binding Initials}" FontSize="24" FontWeight="Bold"
                             Foreground="#E8ECF4" Opacity="0.85"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image Source="{Binding Cover}" Stretch="UniformToFill"
                       IsVisible="{Binding HasCover, FallbackValue=False}"
                       AutomationProperties.AccessibilityView="Raw" />
              </Panel>
            </Border>

            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center" Margin="18,0,18,0">
              <Grid ColumnDefinitions="Auto,Auto,*">
                <TextBlock Grid.Column="0" x:Name="SelectedGameTitle" Text="No game selected" FontSize="20"
                           FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           MaxWidth="420" Margin="0,0,10,0" AutomationProperties.HeadingLevel="2" />

                <!-- Title id / version / size badges, right next to the
                     title. The title's own MaxWidth (not a "*" column) is
                     what keeps them from drifting to the far right. -->
                <StackPanel Grid.Column="1" x:Name="SelectedBadgesRow" Orientation="Horizontal" Spacing="6"
                            IsVisible="False" VerticalAlignment="Center">
                  <Border Classes="pill" IsVisible="{Binding HasTitleId, FallbackValue=False}">
                    <TextBlock Text="{Binding TitleId}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                  </Border>
                  <Border Classes="pill" IsVisible="{Binding HasVersion, FallbackValue=False}">
                    <TextBlock Text="{Binding VersionText}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                  </Border>
                  <Border Classes="pill">
                    <TextBlock Text="{Binding SizeText, FallbackValue=''}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                  </Border>
                </StackPanel>
              </Grid>

              <TextBlock x:Name="SelectedGamePath" Text="Pick a game from the library, or open an eboot.bin directly."
                         FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource FaintBrush}"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Idle" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <ToggleButton x:Name="ConsoleToggle" Classes="ghost" Content="≡ Console"
                            AutomationProperties.AutomationId="ToggleConsoleButton" />
              <Button x:Name="LaunchButton" Classes="accent" Content="▶  Launch" IsEnabled="False"
                      AutomationProperties.AutomationId="LaunchSelectedGameButton" />
              <Button x:Name="StopButton" Classes="danger" Content="■  Stop" IsEnabled="False"
                      AutomationProperties.AutomationId="StopEmulationButton" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Grid x:Name="StatusBar" Grid.Row="2" Height="36" Background="{StaticResource ChromeBrush}"
          ColumnDefinitions="*,Auto">
      <TextBlock x:Name="EmulatorPathText" Grid.Column="0" Text="Emulator: locating…" FontSize="11"
                 Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="16,0"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="StatusBarRight" Grid.Column="1" Text="" FontSize="11"
                 Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="16,0"
                 AutomationProperties.LiveSetting="Polite" />
    </Grid>
  </Grid>
</Window>
